# Use Ubuntu as base image
FROM ubuntu:22.04

# Set non-interactive mode
ENV DEBIAN_FRONTEND=noninteractive
ENV OLLAMA_ORIGINS="*"

# Install Ollama (Modify the installation process if using another base image)
RUN apt update && apt install -y nginx curl && \
    curl -fsSL https://ollama.com/install.sh | sh && \
    rm -rf /var/lib/apt/lists/*

# Copy Nginx configuration file into the container
COPY nginx.conf /etc/nginx/nginx.conf

# Install Ollama
RUN curl -fsSL -o ollama-install.sh https://ollama.com/install.sh && \
    chmod +x ollama-install.sh && \
    ./ollama-install.sh && \
    rm ollama-install.sh

# Expose API port
EXPOSE 11440

# Copy the startup script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Use the script as the entrypoint
ENTRYPOINT ["/entrypoint.sh"]
