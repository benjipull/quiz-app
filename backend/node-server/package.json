{
  "name": "node-ollama-api",
  "version": "1.0.0",
  "description": "A Node.js API that calls Ollama inside Docker",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "populate:difficulty": "node populateAllDifficulty.js",
    "populate:difficulty:all": "node populateAllDifficulty.js --all --limit=0",
    "populate:difficulty:images": "node populateAllDifficulty.js --images-only",
    "populate:difficulty:one": "node scripts/populateDifficulty.js",
    "populate:image-eligibility": "node populateAllImageEligibility.js",
    "populate:image-eligibility:all": "node populateAllImageEligibility.js --all --limit=0",
    "populate:image-eligibility:one": "node scripts/populateImageEligibility.js",
    "populate:question-image64": "node scripts/populateQuestionImage64.js",
    "populate:question-image64:all": "node scripts/populateQuestionImage64.js --all --limit=0",
    "populate:question-image64:eligibility": "node scripts/populateQuestionImage64FromEligibility.js",
    "populate:question-image64:eligibility:all": "node scripts/populateQuestionImage64FromEligibility.js --all",
    "populate:image64": "node scripts/populateCategoryImage64.js",
    "populate:image64:all": "node scripts/populateCategoryImage64.js --all",
    "populate:tags": "node scripts/populateTags.js"
  },
  "dependencies": {
    "@sendgrid/mail": "^7.7.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^6.15.0",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.2.1",
    "resend": "^1.0.0",
    "sharp": "^0.34.5"
  }
}
